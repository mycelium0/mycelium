# fungi — the one-command operator entrypoint for a Mycelium node (RP-0011 chunk C-4).
#
# ORCHESTRATION ONLY. fungi is a thin verb wrapper: it NEVER renders, validates, promotes, restarts, or
# writes a live config itself. All actuation is delegated to scripts/node-bootstrap.sh (the existing
# fail-closed render -> validate -> promote -> rollback actuator), all preview logic to myceliumctl. Its
# only job is a friendly one-command surface; the control logic stays in the existing spine. Engine pins
# (--singbox-*/--xray-*) are filled from control/engines.manifest.json by node-bootstrap itself
# (RP-0011 C-2), so the operator passes none.
#
#   fungi deploy [opts]   converge + bring up detection             (-> node-bootstrap.sh)
#                         --auto-rotate = also let it PROMOTE unattended; --no-arm = serve only
#   fungi update [opts]   fetch + re-render + validate + rollback  (-> node-bootstrap.sh --update)
#   fungi apply  [opts]   apply the node descriptor to the node    (-> node-bootstrap.sh --node-apply)
#   fungi plan   [args]   preview the deploy (resolve pins, print)  (-> myceliumctl deploy-plan; read-only)
#   fungi transport <list|enable|disable> [P]  choose which transports this node serves   (-> myceliumctl transport)
#   fungi front <enable|disable|show> [opts]   turn a bring-your-own-domain CDN front on/off (-> myceliumctl front)
#   fungi reachable <on|off>                   set the node's public-entry posture         (-> myceliumctl reachable)
#   fungi diag <collect|redact>                PII-scrubbed bundle / scrub stdin  (-> myceliumctl diag)
#                         ALWAYS run this before attaching anything to a public issue.
#   fungi status          read-only: what this node is running
#
# Exit: forwards the delegated command's exit; 2 = usage, 3 = the Go spine (plan/transport/front/reachable/diag) is unavailable.

set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [ "${src#/}" = "$src" ] && src="$dir/$src"; done
FUNGI_SELF="$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
REPO_ROOT="$(cd -P "$(dirname "$FUNGI_SELF")/.." && pwd)"
NODE_BOOTSTRAP="$REPO_ROOT/scripts/node-bootstrap.sh"

# usage — print the header block as help. DELIMITED, not line-numbered: this used to be `sed -n '7,24p'`,
# so adding one line to the header silently truncated the help text (and the very first edit after this
# comment was written did exactly that). Anchored on the two markers instead, which move with the content.
usage() {
	awk '/^# fungi — the one-command/{f=1} f&&/^# Exit:/{print; exit} f' "$FUNGI_SELF" \
		| sed 's/^# \{0,1\}//; s/^#$//'
}

# Resolve the Go spine binary that speaks `deploy-plan` (install_spine builds it at
# $TOOLING_DIR/bin/myceliumctl-go; a checkout build lands beside the repo). Fall back gracefully.
resolve_myctl_go() {
	local c
	for c in "${TOOLING_DIR:-/usr/local/lib/mycelium}/bin/myceliumctl-go" "$REPO_ROOT/myceliumctl-go"; do
		[ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
	done
	return 1
}

# READ-ONLY status probe: report what the node is running; never start/stop/restart/mutate anything.
fungi_status() {
	local svc state
	printf 'services:\n'
	if command -v systemctl >/dev/null 2>&1; then
		for svc in sing-box xray myceliumd; do
			state="$(systemctl is-active "$svc" 2>/dev/null || true)"
			[ -n "$state" ] && [ "$state" != "inactive" ] || systemctl list-unit-files "$svc.service" >/dev/null 2>&1 || continue
			printf '  %-10s %s (NRestarts=%s)\n' "$svc" "${state:-unknown}" "$(systemctl show "$svc" -p NRestarts --value 2>/dev/null || echo '?')"
		done
	else
		printf '  (systemctl unavailable)\n'
	fi
	# EVERY BRANCH REPORTS, including the one that cannot look (Audit-0011 #9). Without the `else` this
	# printed the heading and nothing under it on a host with no `ss`, and returned 0 — indistinguishable
	# from "no public listeners", which is the single most alarming thing this command can truthfully say.
	# A status verb that cannot tell "none" from "I could not check" is worse than no status verb.
	local seen=0
	printf 'public listeners:\n'
	if command -v ss >/dev/null 2>&1; then
		local lst
		lst="$(ss -ltnH 2>/dev/null | awk '{print $4}' | grep -vE '127\.0\.0\.1|\[::1\]' | sort -u || true)"
		if [ -n "$lst" ]; then printf '%s\n' "$lst" | sed 's/^/  /'; seen=1
		else printf '  (none — no non-loopback TCP listener)\n'; seen=1; fi
	else
		printf '  (UNKNOWN: ss unavailable, so this host cannot be inspected)\n'
	fi
	printf 'engine versions:\n'
	command -v sing-box >/dev/null 2>&1 && printf '  sing-box %s\n' "$(sing-box version 2>/dev/null | sed -n 's/.*version[[:space:]]*//p' | head -1)"
	command -v xray >/dev/null 2>&1 && printf '  xray %s\n' "$(xray version 2>/dev/null | sed -n 's/^Xray[[:space:]]*//p' | awk '{print $1}' | head -1)"
	command -v sing-box >/dev/null 2>&1 || command -v xray >/dev/null 2>&1 \
		|| printf '  (UNKNOWN: neither engine binary is on PATH from here)\n'
	# The arm sentinel, because "is this node allowed to rotate itself" is the one piece of posture an
	# operator cannot infer from listeners or versions, and it is the difference between a node that
	# adapts unattended and one that only plans.
	# ENGINE PIN DRIFT (Audit-0011 #20). install_singbox runs only inside flow_bootstrap, while
	# install_xray also runs from converge_node_tail — so bumping the manifest for a CVE reaches the
	# SECONDARY engine unattended and never reaches the PRIMARY one. Upgrading a data-plane binary on a
	# timer is a posture change nobody has authorised, so this REPORTS the drift instead of acting on it,
	# and RELEASING.md says plainly that engine pins need an attended deploy.
	printf 'engine pin: '
	local mfile pin cur
	mfile="${MYC_ARTIFACT_ROOT:-/opt/mycelium}/control/engines.manifest.json"
	if [ -r "$mfile" ] && command -v jq >/dev/null 2>&1 && command -v sing-box >/dev/null 2>&1; then
		pin="$(jq -r '.. | .singbox? // empty | .version? // empty' "$mfile" 2>/dev/null | head -1)"
		cur="$(sing-box version 2>/dev/null | sed -n 's/.*version[[:space:]]*//p' | head -1)"
		if [ -z "$pin" ]; then printf '(UNKNOWN: no sing-box pin readable in the manifest)\n'
		elif [ "${pin#v}" = "${cur#v}" ]; then printf 'sing-box matches the manifest (%s)\n' "$cur"
		else printf 'DRIFT — installed sing-box %s, manifest pins %s. The primary engine is NOT upgraded by the unattended converge; re-run `fungi deploy` to pick it up.\n' "${cur:-unknown}" "$pin"; fi
	else
		printf '(UNKNOWN: manifest or engine not readable from here)\n'
	fi
	printf 'unattended rotation: '
	if [ -e "${MYC_STATE_DIR:-/var/lib/mycelium}/rotate-live.enabled" ]; then printf 'ARMED (the loop may promote)\n'
	elif [ -d "${MYC_STATE_DIR:-/var/lib/mycelium}" ]; then printf 'not armed (plans only; arm with `fungi deploy --auto-rotate`)\n'
	else printf '(UNKNOWN: no node state directory here)\n'; fi
	# Non-zero when NOTHING could be observed: a status that always exits 0 cannot be used in a check.
	[ "$seen" -eq 1 ] || return 1
	return 0
}

fungi_die() { printf 'fungi: error: %s\n' "$*" >&2; exit 2; }

[ -x "$NODE_BOOTSTRAP" ] || { echo "fungi: actuator not found: $NODE_BOOTSTRAP" >&2; exit 2; }

case "${1:-}" in
	deploy) shift
		# Deploy converges the node and then, by default, brings up DETECTION: the MEASURE plane + L7
		# liveness probe, and the rotation loop that consumes them. It does NOT place the rotate-live
		# sentinel. Without that sentinel the loop runs, plans, and reports — and refuses to promote
		# anything (nb_rotate_apply.sh, the armed check before rotate_apply_live). Unattended PROMOTION is
		# a separate, deliberate act: --auto-rotate.
		#
		# WHY THE SPLIT (2026-07-31). Rotation is protected by a triple gate — dry-run by default,
		# --apply-rotation required, and a node-local sentinel — and the doctrine around it said "a deploy
		# can never actuate a node". That was true of node-bootstrap's own flows and false here: this verb
		# placed the sentinel, and the loop's own unit hardcodes `--rotate --apply-rotation` in its
		# ExecStart, so a bare `fungi deploy` satisfied ALL THREE legs in one command, with no prompt and
		# no --yes, and the first tick fired during the deploy itself. Every leg was still present and
		# correctly nested; what was wrong was that one command supplied all of them. The gate held and
		# the claim about it did not.
		#
		# The three arm steps remain the SAME explicit node-bootstrap dispatches an operator would run by
		# hand, and the timer-driven `fungi update` still NEVER arms — an auto-pull cannot self-arm a node.
		# Idempotent. Both flags are fungi-level and are NOT forwarded (node-bootstrap dies on an unknown
		# flag, which would abort the whole deploy):
		#   default        measure + L7 probe + the rotation loop, planning only
		#   --auto-rotate  the above PLUS the sentinel: the loop may promote unattended
		#   --no-arm       none of the three: serve only
		arm=1; autorotate=0; deploy_args=()
		# ALLOW-LIST, not pass-through (Audit-0011 #7). Everything unrecognised used to be forwarded to
		# node-bootstrap.sh, which parses each flag as a whole-run MODE, last-wins. So
		# `fungi deploy --revoke alice` REVOKED A CLIENT and never converged — the verb the operator typed
		# was silently replaced by a different one, and `deploy` reported success. A converge verb must not
		# be a channel for reaching every other mode by accident.
		for a in "$@"; do
			case "$a" in
				--no-arm)      arm=0 ;;
				--auto-rotate) autorotate=1 ;;
				# Converge-shaping flags: safe on this path because none of them selects a MODE.
				--clients|--client-names|--node-address|--allowed-signers|--singbox-version|--xray-version|--repo-url|--repo-ref)
					deploy_args+=("$a"); shift_next=1 ;;
				--no-harden|--harden|--no-amneziawg|--no-observability|--assume-yes|--dry-run|--staged)
					deploy_args+=("$a") ;;
				--*=*) case "${a%%=*}" in
						--clients|--client-names|--node-address|--allowed-signers|--singbox-version|--xray-version|--repo-url|--repo-ref)
							deploy_args+=("$a") ;;
						*) fungi_die "deploy: unknown flag '$a'." ;;
					esac ;;
				-*)  fungi_die "deploy: '$a' is not a deploy flag. node-bootstrap.sh parses mode flags like --revoke/--rotate/--update as a WHOLE-RUN MODE, last-wins, so forwarding it here would silently run a DIFFERENT verb than the one you typed." ;;
				*)   # a bare value belonging to the previous flag (e.g. `--clients alice`)
					if [ "${shift_next:-0}" -eq 1 ]; then deploy_args+=("$a"); shift_next=0
					else fungi_die "deploy: unexpected argument '$a'."; fi ;;
			esac
		done
		"$NODE_BOOTSTRAP" ${deploy_args[@]+"${deploy_args[@]}"}
		if [ "$arm" -eq 1 ]; then
			echo "fungi deploy: bringing up detection (MEASURE plane + L7 liveness probe + rotation loop)..." >&2
			"$NODE_BOOTSTRAP" ${deploy_args[@]+"${deploy_args[@]}"} --measure-enable
			if [ "$autorotate" -eq 1 ]; then
				echo "fungi deploy: --auto-rotate given — placing the rotate-live sentinel. This node MAY PROMOTE A" >&2
				echo "              CONFIG UNATTENDED when the planner decides a served transport is impaired." >&2
				"$NODE_BOOTSTRAP" ${deploy_args[@]+"${deploy_args[@]}"} --rotate-arm
			fi
			"$NODE_BOOTSTRAP" ${deploy_args[@]+"${deploy_args[@]}"} --rotate-enable-loop
			if [ "$autorotate" -eq 0 ]; then
				# REPORT THE NODE'S STATE, not this invocation's variable. Saying "NOT armed" because THIS
				# deploy did not arm is false on a node armed earlier — and it was reachable the obvious way:
				# QUICKSTART said "arming later is --rotate-arm", an operator writes `fungi deploy
				# --rotate-arm`, fungi forwards the unknown flag, node-bootstrap takes it as a MODE, the node
				# arms (skipping the converge entirely), and fungi then prints that it is not armed. A safety
				# statement that can be wrong is worse than no statement.
				_sd="/var/lib/mycelium"
				_prev=""
				for _a in ${deploy_args[@]+"${deploy_args[@]}"}; do
					[ "$_prev" = "--state-dir" ] && _sd="$_a"
					_prev="$_a"
				done
				if [ -e "$_sd/rotate-live.enabled" ]; then
					echo "fungi deploy: this deploy did not place the rotate-live sentinel, but one is ALREADY present" >&2
					echo "              at $_sd/rotate-live.enabled — the loop may promote unattended. Remove that file" >&2
					echo "              to disarm." >&2
				else
					echo "fungi deploy: the rotation loop is running but NOT armed — it will plan and report, and will" >&2
					echo "              refuse to promote. Re-deploy with --auto-rotate to let it act, or run" >&2
					echo "              '$NODE_BOOTSTRAP --rotate-arm' when you want that." >&2
				fi
			fi
		fi
		;;
	update) shift; exec "$NODE_BOOTSTRAP" --update "$@" ;;
	apply)  shift; exec "$NODE_BOOTSTRAP" --node-apply "$@" ;;
	plan)   shift
		mc="$(resolve_myctl_go)" || { echo "fungi plan: the Go spine (myceliumctl-go) is not built here; run 'fungi deploy' first, or use 'myceliumctl deploy-plan' from a checkout." >&2; exit 3; }
		# Run from REPO_ROOT so deploy-plan's relative default --manifest (control/engines.manifest.json)
		# resolves regardless of the operator's cwd (the live descriptor default is an absolute path).
		cd "$REPO_ROOT" && exec "$mc" deploy-plan "$@" ;;
	transport|reachable|front) verb="$1"; shift
		# The operator's single surface for choosing WHAT the node serves — which transports, the public
		# posture, and the bring-your-own-domain CDN/ingress front. Delegated to the Go spine, which
		# VALIDATES + writes the node-local descriptor / front config (write-only intent); nothing actuates
		# until the next deploy/apply. Same resolve-or-explain fallback as `plan` (the spine must be built —
		# run `fungi deploy` once first, or edit from a checkout with myceliumctl directly).
		mc="$(resolve_myctl_go)" || { echo "fungi $verb: the Go spine (myceliumctl-go) is not built here; run 'fungi deploy' first, or use 'myceliumctl $verb' from a checkout." >&2; exit 3; }
		exec "$mc" "$verb" "$@" ;;
	diag) shift
		# THE SURFACE THAT DID NOT EXIST (Audit-0011 #8). SECURITY.md and the bug-report template both
		# told reporters to run `myceliumctl diag collect` — but nothing puts any `myceliumctl` on $PATH,
		# and the only file of that name on a node is the SHELL tool, whose dispatch has no `diag` verb at
		# all. So the redactor built precisely to keep keys, peer addresses and client names out of a
		# public issue was unreachable by the person it protects, and the path of least resistance was
		# pasting raw journald. The scrubber existing is not the same as the scrubber being reachable.
		mc="$(resolve_myctl_go)" || { echo "fungi diag: the Go spine (myceliumctl-go) is not built here, so the PII redactor cannot run. Run 'fungi deploy' on this node first. DO NOT paste raw logs into a public issue — they carry peer addresses, client names and key material." >&2; exit 3; }
		exec "$mc" diag "$@" ;;
	status) shift; fungi_status ;;
	help|-h|--help) usage; exit 0 ;;
	"") usage >&2; exit 2 ;;
	*) echo "fungi: unknown verb '$1' (deploy|update|apply|plan|transport|front|reachable|diag|status)" >&2; usage >&2; exit 2 ;;
esac
